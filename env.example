# =============================================================================
# env.example — copy this file to ".env" and fill in your values
#
#   cp env.example .env
#
# The real .env file is gitignored. Never commit it.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: LeetCode authentication
# -----------------------------------------------------------------------------
# How to get these values:
#   1. Log in to leetcode.com in your browser.
#   2. Open DevTools (F12) → Application tab (Chrome/Edge) or Storage tab (Firefox).
#   3. Expand Cookies → click https://leetcode.com.
#   4. Copy LEETCODE_SESSION (long string) and csrftoken → paste into CSRF_TOKEN below.
#
# These cookies expire periodically — if fetches start failing, grab fresh values.
# Treat them like passwords; they give read access to your LeetCode account.
LEETCODE_SESSION=
CSRF_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL: directory configuration
# -----------------------------------------------------------------------------
# Where the problem universe cache, history snapshots, and generated outputs
# live. Default: ./data
# LEETCODE_DATA_DIR=./data

# -----------------------------------------------------------------------------
# OPTIONAL: pipeline configuration
# -----------------------------------------------------------------------------

# FETCH_LIMIT — submissions to pull on a normal (non-first) run.
# On the very first run (no history file yet) we pull FIRST_RUN_FETCH_LIMIT
# instead, to bootstrap your personal profile.
FETCH_LIMIT=60

# FIRST_RUN_FETCH_LIMIT — submissions to pull when no history exists yet.
# A bigger initial pull gives the recommender a meaningful weakness profile
# right out of the gate.
FIRST_RUN_FETCH_LIMIT=500

# ENRICH_LIMIT — max NEW problems per run to enrich with difficulty+tags
# (one GraphQL call each). Keep low for faster runs.
ENRICH_LIMIT=100

# TOP_K — number of problems in the final workout plan output.
# Recommended: 10 for daily practice, 20 for weekend sessions.
TOP_K=10

# REVIEW_PERCENTAGE — mix of review vs new problems (1-100).
# Based on learning science (~85% accuracy is the optimal-error sweet spot):
#   80-90 → Consolidation (interview prep, solidifying skills)
#   60-80 → Balanced learning (recommended for most users)
#   40-60 → Growth mode (expanding to new problem types)
#   20-40 → Challenge mode (unfamiliar territory)
REVIEW_PERCENTAGE=70

# SKIP_FETCH — skip downloading new submissions and regenerate
# recommendations from existing data. true / false
SKIP_FETCH=false

# -----------------------------------------------------------------------------
# OPTIONAL: problem universe filters
# -----------------------------------------------------------------------------

# ALLOW_PREMIUM — include LeetCode Premium problems in recommendations.
# Default false: free-only problems. Set true if you have an active Premium
# subscription and want Premium problems in your rotation.
ALLOW_PREMIUM=false

# NEETCODE150_ONLY — restrict the candidate pool to the bundled NeetCode 150
# list. Set false to allow problems from outside that list — requires the
# optional expanded dataset (see below).
NEETCODE150_ONLY=true

# -----------------------------------------------------------------------------
# OPTIONAL: expanded problem dataset
# -----------------------------------------------------------------------------
# To get recommendations outside the NeetCode 150, download a broader LeetCode
# problem dataset and place it at data/Leetcode.csv. Suggested source:
#   https://www.kaggle.com/datasets/ashutoshpapnoi/latest-complete-leetcode-problems-dataset-2025
# Then set NEETCODE150_ONLY=false above.
