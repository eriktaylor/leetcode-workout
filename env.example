# =============================================================================
# .env.example — copy this file to ".env" and fill in your values
#
#   cp .env.example .env
#
# The real .env file is gitignored. Never commit it.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: LeetCode authentication
# -----------------------------------------------------------------------------
# See README.md → "Getting your LeetCode credentials" for how to grab these
# from your browser cookies. Both are required.
LEETCODE_SESSION=
CSRF_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL: directory configuration
# -----------------------------------------------------------------------------
# Where input datasets and generated outputs live. Default: ./data
# Tip: keep this inside the repo so the .gitignore rules apply.
# LEETCODE_DATA_DIR=./data

# -----------------------------------------------------------------------------
# OPTIONAL: pipeline configuration
# -----------------------------------------------------------------------------

# FETCH_LIMIT — number of recent submissions to download per run.
# Higher = more complete history but slower.
# Recommended: 200 for weekly runs, 500+ for first-time setup.
FETCH_LIMIT=60

# ENRICH_LIMIT — max NEW problems to fetch metadata for per run.
# Each new problem = one API call (~1s). Keep low for faster runs.
ENRICH_LIMIT=100

# TARGET_CANDIDATES — size of the candidate pool the algorithm scores
# before picking the top. Higher = more variety, slower.
TARGET_CANDIDATES=75

# TOP_K — number of problems in the final workout plan output.
# Recommended: 10 for daily practice, 20 for weekend sessions.
TOP_K=10

# REVIEW_PERCENTAGE — mix of review vs new problems (1-100).
# Based on learning science (~85% accuracy is the optimal-error sweet spot):
#   80-90 → Consolidation (interview prep, solidifying skills)
#   60-80 → Balanced learning (recommended for most users)
#   40-60 → Growth mode (expanding to new problem types)
#   20-40 → Challenge mode (unfamiliar territory)
REVIEW_PERCENTAGE=71

# SKIP_FETCH — skip downloading new submissions and regenerate
# recommendations from existing data. true / false
SKIP_FETCH=false
